<!-- Architecture & Autoscaling Strategy -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold text-dark">&#x1F527; Load Test Execution In Solution</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    The solution includes the dedicated <strong>`AgriStream.LoadTest`</strong> project in Visual Studio.
                </p>
                <ul class="small text-muted mb-3">
                    <li><strong>Project in Solution:</strong> <code>AgriStream.LoadTest\AgriStream.LoadTest.csproj</code></li>
                    <li><strong>One-Click Launcher:</strong> <code>Run_Task_e_LoadTest.bat</code> in root folder</li>
                    <li><strong>JMeter Test Plan:</strong> <code>AgriStream_LoadTest.jmx</code> in root folder</li>
                    <li><strong>Report Document:</strong> <code>Task_e_LoadTesting_Report_ST10212542.md</code></li>
                </ul>
                <div class="alert alert-light border small mb-0">
                    Run anytime by executing: <code>dotnet run --project AgriStream.LoadTest</code>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold text-dark">&#x2699;&#xFE0F; App Service Autoscaling Rules (Task a Alignment)</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    Configured metric alert thresholds for production farm scale:
                </p>
                <div class="mb-3">
                    <span class="badge bg-danger mb-1">Scale-Out Rule</span>
                    <p class="small text-muted mb-0">
                        When <strong>Average CPU &gt; 70%</strong> for 5 consecutive minutes, scale out by <strong>+1 instance</strong> (max 3 instances).
                    </p>
                </div>
                <div>
                    <span class="badge bg-success mb-1">Scale-In Rule</span>
                    <p class="small text-muted mb-0">
                        When <strong>Average CPU &lt; 25%</strong> for 10 consecutive minutes, scale in by <strong>-1 instance</strong> (min 1 instance) to optimize cloud hosting costs.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
