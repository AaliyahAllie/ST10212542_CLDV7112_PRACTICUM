@{
    ViewData["Title"] = "About AgriStream";
}

<div class="card mb-4">
    <div class="card-header py-3">
        <h4 class="mb-0 fw-bold text-dark">About AgriStream IoT Commercial Farming</h4>
        <small class="text-muted">Company background, agricultural technology, and operational services</small>
    </div>
    <div class="card-body p-4">
        <h5 class="fw-bold text-dark">Company Background</h5>
        <p class="text-muted">
            AgriStream IoT is an agricultural technology provider specializing in data-driven farm management solutions for commercial crop operations. Our platform enables commercial growers, farm managers, and consulting agronomists to monitor soil conditions, track microclimate variables, and conduct rapid crop inspections remotely.
        </p>

        <hr class="my-4" />

        <h5 class="fw-bold text-dark mb-3">Core Farm Operations Services</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="p-3 bg-light border rounded h-100">
                    <h6 class="fw-bold text-dark">&#x1F331; 1. Multi-Depth Soil Telemetry</h6>
                    <p class="small text-muted mb-0">
                        In-ground soil probes and solar-powered weather stations transmit continuous sensor readings, detecting moisture deficits and root-zone stress before visible crop damage occurs.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light border rounded h-100">
                    <h6 class="fw-bold text-dark">&#x1F681; 2. Aerial Drone Surveys</h6>
                    <p class="small text-muted mb-0">
                        Autonomous field drones capture high-resolution imagery over large crop parcels to evaluate canopy vitality, identify weed infestation zones, and verify irrigation distribution.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light border rounded h-100">
                    <h6 class="fw-bold text-dark">&#x1F4A7; 3. Remote Valve Actuation</h6>
                    <p class="small text-muted mb-0">
                        Farm operators remotely dispatch irrigation cycles for designated parcels based on live moisture thresholds, optimizing water consumption and protecting yields.
                    </p>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <h5 class="fw-bold text-dark mb-2">Operations Access Roles</h5>
        <ul class="text-muted">
            <li class="mb-1"><strong class="text-dark">Farmers:</strong> Manage daily field operations, monitor current probe metrics, and dispatch remote irrigation cycles.</li>
            <li class="mb-1"><strong class="text-dark">Agronomists:</strong> Analyze soil moisture trends, evaluate soil chemistry, and review aerial survey photography.</li>
            <li><strong class="text-dark">Administrators:</strong> Maintain the hardware inventory, configure farm parcels, and manage staff user accounts.</li>
        </ul>
    </div>
</div>
