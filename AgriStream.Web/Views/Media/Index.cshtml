@model IEnumerable<AgriStream.Web.Models.DroneMedia>
@{
    ViewData["Title"] = "Drone Aerial Surveys";
    bool canUpload = User.IsInRole("Agronomist") || User.IsInRole("Admin");
    bool canDelete = User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0 fw-bold text-dark">Drone Aerial Imagery Archive</h3>
        <small class="text-muted">High-resolution photographic crop surveys captured by automated field drones</small>
    </div>
    <div class="mt-2 mt-md-0 d-flex align-items-center">
        @if (canUpload)
        {
            <a asp-action="Upload" class="btn btn-sm btn-agri-primary">
                + Upload Drone Survey
            </a>
        }
        else
        {
            <span class="badge bg-light text-muted border py-2 px-2" title="Drone survey upload is managed by Agronomists and Admins">
                Survey Uploads: Agronomist
            </span>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center text-muted">
        <h5 class="fw-bold text-dark">No Aerial Surveys Found</h5>
        <p class="small">Upload aerial images taken by field drones to inspect crop conditions and canopy health.</p>
        @if (canUpload)
        {
            <div>
                <a asp-action="Upload" class="btn btn-sm btn-agri-primary">Upload First Survey</a>
            </div>
        }
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <img src="@item.BlobUrl" alt="@item.FileName" class="card-img-top" style="height: 200px; object-fit: cover;"
                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=800&auto=format&fit=crop&q=60';" />
                    <div class="card-body d-flex flex-column p-3">
                        <h6 class="card-title fw-bold text-truncate mb-2 text-dark" title="@item.FileName">@item.FileName</h6>
                        <div class="small text-muted mb-1">
                            <strong>Field Parcel:</strong> @(item.Field?.FieldName ?? "Field " + item.FieldId)
                        </div>
                        <div class="small text-muted mb-1">
                            <strong>Flight Altitude:</strong> @(item.FlightAltitudeMeters ?? 120) meters AGL
                        </div>
                        <div class="small text-muted mb-3">
                            <strong>Survey Date:</strong> @item.CapturedAt.ToString("yyyy/MM/dd HH:mm")
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                            <a href="@item.BlobUrl" target="_blank" class="btn btn-sm btn-outline-secondary">View Image</a>
                            @if (canDelete)
                            {
                                <form asp-action="Delete" asp-route-id="@item.MediaId" method="post" onsubmit="return confirm('Delete this aerial survey from Azure Blob & SQL?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border small">Verified Survey</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
