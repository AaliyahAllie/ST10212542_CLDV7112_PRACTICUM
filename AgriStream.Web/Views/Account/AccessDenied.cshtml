@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-shield-x fs-1 text-danger"></i>
            <h2 class="fw-bold mt-3">Access Denied</h2>
            <p class="text-secondary">Your assigned system role does not have permission to access this resource.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-2">
                <i class="bi bi-house me-1"></i> Return Home
            </a>
        </div>
    </div>
</div>
