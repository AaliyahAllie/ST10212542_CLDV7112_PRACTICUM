{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<your-sql-server-name>.database.windows.net,1433;Initial Catalog=<your-database-name>;User ID=<your-username>;Password=<your-password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "AzureStorageConnection": "DefaultEndpointsProtocol=https;AccountName=<your-storage-account-name>;AccountKey=<your-storage-account-key>;EndpointSuffix=core.windows.net"
  },
  "AzureFunctionSettings": {
    "BaseUrl": "https://<your-function-app-name>.azurewebsites.net"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
